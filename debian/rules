#!/usr/bin/make -f

export CC := clang-20
export CXX := clang++-20
# Avoid the distro fat-LTO path with Clang and GNU archive/link tools.
export DEB_BUILD_MAINT_OPTIONS := hardening=+all optimize=-lto

ifneq (,$(filter nogui,$(DEB_BUILD_PROFILES)))
GUI_ENABLED := OFF
GUI_DEPENDS :=
else
GUI_ENABLED := ON
GUI_DEPENDS := qt6-qpa-plugins, qt6-wayland
endif

%:
	dh $@ --buildsystem=cmake+ninja

# Keep strict ccache macro/time checks by avoiding PCH in cached builds.
override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_TESTING=ON \
		-DCMAKE_DISABLE_PRECOMPILE_HEADERS=$(if $(filter ccache,$(CMAKE_CXX_COMPILER_LAUNCHER)),ON,OFF) \
		-DONEDRIVE_OFFLINE_BUILD=ON \
		-DFETCHCONTENT_FULLY_DISCONNECTED=OFF \
		-DONEDRIVE_DEBIAN_PACKAGE_BUILD=ON \
		-DONEDRIVE_BUILD_GUI=$(GUI_ENABLED)

override_dh_gencontrol:
	dh_gencontrol -- -Vonedrive:GUI-Depends="$(GUI_DEPENDS)"

# The system dwz does not support Clang 20's DWARF sections.
override_dh_dwz:
