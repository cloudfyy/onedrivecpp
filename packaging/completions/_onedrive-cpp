#compdef onedrive-cpp

_onedrive_cpp()
{
    local context state line
    typeset -A opt_args

    _arguments -C \
        '(-h --help)'{-h,--help}'[show command help]' \
        '--version[show version information]' \
        '1:command:(account inspect state transfer)' \
        '*::argument:->command_options'

    case "${line[1]}" in
        account)
            case "${line[2]}" in
                login)
                    _arguments \
                        '(-h --help)'{-h,--help}'[show command help]' \
                        '--config[path to configuration file]:configuration file:_files' \
                        '--log-level[minimum log level]:level:(trace debug info warn error critical off)' \
                        '--log-file[write rotating logs to file]:log file:_files' \
                        '--color[color output mode]:mode:(auto always never)' \
                        '--output[output format]:format:(text json)' \
                        '--ui[authentication interface]:mode:(auto console tui)' \
                        '--theme[TUI color theme]:theme:(hacker ocean amber synthwave)' \
                        '--quiet[suppress informational and success output]'
                    ;;
                logout)
                    _arguments \
                        '(-h --help)'{-h,--help}'[show command help]' \
                        '--config[path to configuration file]:configuration file:_files' \
                        '--log-level[minimum log level]:level:(trace debug info warn error critical off)' \
                        '--log-file[write rotating logs to file]:log file:_files' \
                        '--color[color output mode]:mode:(auto always never)' \
                        '--output[output format]:format:(text json)' \
                        '--quiet[suppress informational and success output]'
                    ;;
                *)
                    _arguments \
                        '1:account action:(login logout)'
                    ;;
            esac
            ;;
        inspect)
            case "${line[2]}" in
                health|status|drives|shared|quota|storage|partials)
                    _arguments \
                        '(-h --help)'{-h,--help}'[show command help]' \
                        '--config[path to configuration file]:configuration file:_files' \
                        '--log-level[minimum log level]:level:(trace debug info warn error critical off)' \
                        '--log-file[write rotating logs to file]:log file:_files' \
                        '--color[color output mode]:mode:(auto always never)' \
                        '--output[output format]:format:(text json)' \
                        '--ui[inspection interface]:mode:(auto console tui)' \
                        '--theme[TUI color theme]:theme:(hacker ocean amber synthwave)' \
                        '--quiet[suppress informational and success output]'
                    ;;
                files)
                    _arguments \
                        '(-h --help)'{-h,--help}'[show command help]' \
                        '--config[path to configuration file]:configuration file:_files' \
                        '--log-level[minimum log level]:level:(trace debug info warn error critical off)' \
                        '--log-file[write rotating logs to file]:log file:_files' \
                        '--color[color output mode]:mode:(auto always never)' \
                        '--output[output format]:format:(text json)' \
                        '--ui[inspection interface]:mode:(auto console tui)' \
                        '--theme[TUI color theme]:theme:(hacker ocean amber synthwave)' \
                        '--quiet[suppress informational and success output]' \
                        '--status[filter by local file status]:status:(ok missing modified type-changed outside-root)' \
                        '1:Drive-relative file or directory path:'
                    ;;
                sites)
                    _arguments \
                        '(-h --help)'{-h,--help}'[show command help]' \
                        '--config[path to configuration file]:configuration file:_files' \
                        '--log-level[minimum log level]:level:(trace debug info warn error critical off)' \
                        '--log-file[write rotating logs to file]:log file:_files' \
                        '--color[color output mode]:mode:(auto always never)' \
                        '--output[output format]:format:(text json)' \
                        '--ui[inspection interface]:mode:(auto console tui)' \
                        '--theme[TUI color theme]:theme:(hacker ocean amber synthwave)' \
                        '--quiet[suppress informational and success output]' \
                        '1:SharePoint site search query:'
                    ;;
                *)
                    _arguments \
                        '1:inspection action:(health status drives shared sites quota storage partials files)'
                    ;;
            esac
            ;;
        transfer)
            case "${line[2]}" in
                sync)
                    _arguments \
                        '(-h --help)'{-h,--help}'[show command help]' \
                        '--config[path to configuration file]:configuration file:_files' \
                        '--log-level[minimum log level]:level:(trace debug info warn error critical off)' \
                        '--log-file[write rotating logs to file]:log file:_files' \
                        '--color[color output mode]:mode:(auto always never)' \
                        '--output[output format]:format:(text json)' \
                        '--ui[sync interface]:mode:(auto console tui)' \
                        '--theme[TUI color theme]:theme:(hacker ocean amber synthwave)' \
                        '--quiet[suppress informational and success output]' \
                        '--dry-run[show synchronization plan without changing files]' \
                        '--force-large-delete[allow this sync to exceed the remote deletion limit]'
                    ;;
                download)
                    _arguments \
                        '(-h --help)'{-h,--help}'[show command help]' \
                        '--config[path to configuration file]:configuration file:_files' \
                        '--log-level[minimum log level]:level:(trace debug info warn error critical off)' \
                        '--log-file[write rotating logs to file]:log file:_files' \
                        '--color[color output mode]:mode:(auto always never)' \
                        '--output[output format]:format:(text json)' \
                        '--ui[download interface]:mode:(auto console tui)' \
                        '--theme[TUI color theme]:theme:(hacker ocean amber synthwave)' \
                        '--quiet[suppress informational and success output]' \
                        '--dry-run[show download plan without changing local state]' \
                        '1:remote Drive-relative path:'
                    ;;
                watch)
                    _arguments \
                        '(-h --help)'{-h,--help}'[show command help]' \
                        '--config[path to configuration file]:configuration file:_files' \
                        '--log-level[minimum log level]:level:(trace debug info warn error critical off)' \
                        '--log-file[write rotating logs to file]:log file:_files' \
                        '--color[color output mode]:mode:(auto always never)' \
                        '--output[output format]:format:(text json)' \
                        '--ui[watch interface]:mode:(auto console tui)' \
                        '--theme[TUI color theme]:theme:(hacker ocean amber synthwave)' \
                        '--quiet[suppress informational and success output]'
                    ;;
                *)
                    _arguments \
                        '1:transfer action:(sync download watch)'
                    ;;
            esac
            ;;
        state)
            case "${line[2]}" in
                reset-cursor)
                    _arguments \
                        '(-h --help)'{-h,--help}'[show command help]' \
                        '--config[path to configuration file]:configuration file:_files' \
                        '--log-level[minimum log level]:level:(trace debug info warn error critical off)' \
                        '--log-file[write rotating logs to file]:log file:_files' \
                        '--color[color output mode]:mode:(auto always never)' \
                        '--output[output format]:format:(text json)' \
                        '--quiet[suppress informational and success output]'
                    ;;
                clear)
                    _arguments \
                        '(-h --help)'{-h,--help}'[show command help]' \
                        '--config[path to configuration file]:configuration file:_files' \
                        '--log-level[minimum log level]:level:(trace debug info warn error critical off)' \
                        '--log-file[write rotating logs to file]:log file:_files' \
                        '--color[color output mode]:mode:(auto always never)' \
                        '--output[output format]:format:(text json)' \
                        '--quiet[suppress informational and success output]' \
                        '--yes[confirm state clear without an interactive prompt]'
                    ;;
                *)
                    _arguments \
                        '1:state action:(reset-cursor clear)'
                    ;;
            esac
            ;;
    esac
}

_onedrive_cpp "$@"
