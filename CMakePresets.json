{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_CXX_COMPILER": "clang++-20"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug with system libraries",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release with system libraries",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "lint",
      "displayName": "Debug with Clang-Tidy checks",
      "inherits": "debug",
      "cacheVariables": {
        "ONEDRIVE_ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "e2e",
      "displayName": "Release with live Microsoft Graph tests",
      "inherits": "release",
      "cacheVariables": {
        "ONEDRIVE_ENABLE_GRAPH_E2E": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "lint",
      "configurePreset": "lint"
    },
    {
      "name": "e2e",
      "configurePreset": "e2e"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "e2e",
      "configurePreset": "e2e",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
