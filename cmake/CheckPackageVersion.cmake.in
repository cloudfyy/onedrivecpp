cmake_policy(VERSION 3.28)
set(PROJECT_SOURCE_DIR "@PROJECT_SOURCE_DIR@")
set(PROJECT_VERSION "@PROJECT_VERSION@")
set(ONEDRIVE_DEBIAN_PACKAGE_BUILD "@ONEDRIVE_DEBIAN_PACKAGE_BUILD@")
if(NOT CPACK_DEBIAN_PACKAGE_RELEASE MATCHES "^([A-Za-z0-9.+~]+)~([A-Za-z0-9][A-Za-z0-9.+]*)$")
    message(FATAL_ERROR "Invalid CPACK_DEBIAN_PACKAGE_RELEASE: ${CPACK_DEBIAN_PACKAGE_RELEASE}")
endif()
set(ONEDRIVE_PACKAGE_REVISION "${CMAKE_MATCH_1}")
set(ONEDRIVE_PACKAGE_DISTRIBUTION "${CMAKE_MATCH_2}")
include("@CMAKE_CURRENT_LIST_DIR@/PackageVersion.cmake")
if(NOT CPACK_PACKAGE_VERSION STREQUAL ONEDRIVE_MANIFEST_VERSION)
    message(FATAL_ERROR "CPACK_PACKAGE_VERSION does not match vcpkg.json")
endif()
if(@ONEDRIVE_PACKAGE_REVISION_FROM_CHANGELOG@ AND
    CPACK_DEBIAN_PACKAGE_RELEASE STREQUAL "@CPACK_DEBIAN_PACKAGE_RELEASE@" AND
    NOT ONEDRIVE_PACKAGE_REVISION STREQUAL ONEDRIVE_CHANGELOG_REVISION)
    message(FATAL_ERROR "Changelog revision changed; reconfigure before packaging")
endif()
if(DEFINED CPACK_DEBIAN_PACKAGE_VERSION AND
    NOT CPACK_DEBIAN_PACKAGE_VERSION STREQUAL ONEDRIVE_MANIFEST_VERSION)
    message(FATAL_ERROR "CPACK_DEBIAN_PACKAGE_VERSION does not match vcpkg.json")
endif()
if(DEFINED CPACK_DEBIAN_PACKAGE_EPOCH AND NOT CPACK_DEBIAN_PACKAGE_EPOCH STREQUAL "")
    message(FATAL_ERROR "Package epochs are not used by the project version scheme")
endif()
