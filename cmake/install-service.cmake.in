set(ONEDRIVE_SERVICE_BINDIR [==[@CMAKE_INSTALL_BINDIR@]==])
cmake_path(
    ABSOLUTE_PATH ONEDRIVE_SERVICE_BINDIR
    BASE_DIRECTORY "${CMAKE_INSTALL_PREFIX}"
    NORMALIZE
)
set(ONEDRIVE_SERVICE_EXECUTABLE "${ONEDRIVE_SERVICE_BINDIR}/onedrive-cpp")
string(REPLACE "\\" "\\\\" ONEDRIVE_SERVICE_EXECUTABLE "${ONEDRIVE_SERVICE_EXECUTABLE}")
string(REPLACE "\"" "\\\"" ONEDRIVE_SERVICE_EXECUTABLE "${ONEDRIVE_SERVICE_EXECUTABLE}")
string(REPLACE "%" "%%" ONEDRIVE_SERVICE_EXECUTABLE "${ONEDRIVE_SERVICE_EXECUTABLE}")
string(REPLACE "\t" "\\t" ONEDRIVE_SERVICE_EXECUTABLE "${ONEDRIVE_SERVICE_EXECUTABLE}")
string(REPLACE "\n" "\\n" ONEDRIVE_SERVICE_EXECUTABLE "${ONEDRIVE_SERVICE_EXECUTABLE}")
string(REPLACE "\r" "\\r" ONEDRIVE_SERVICE_EXECUTABLE "${ONEDRIVE_SERVICE_EXECUTABLE}")
set(ONEDRIVE_SERVICE_FILE "${CMAKE_INSTALL_PREFIX}/lib/systemd/user/onedrive-cpp.service")
configure_file(
    "@CMAKE_CURRENT_LIST_DIR@/../packaging/systemd/onedrive-cpp.service.in"
    "$ENV{DESTDIR}${ONEDRIVE_SERVICE_FILE}"
    @ONLY
)
list(APPEND CMAKE_INSTALL_MANIFEST_FILES "${ONEDRIVE_SERVICE_FILE}")
